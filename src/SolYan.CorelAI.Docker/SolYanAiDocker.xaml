<UserControl x:Class="SolYan.CorelAI.Docker.SolYanAiDocker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300" MinHeight="530">
  <Grid Background="#17191D">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#20242A" Padding="14,12">
      <DockPanel LastChildFill="True">
        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#D9A441" Margin="0,0,9,0" VerticalAlignment="Center" />
        <StackPanel>
          <TextBlock Text="SolYan AI" Foreground="White" FontWeight="SemiBold" FontSize="16" />
          <TextBlock x:Name="StatusText" Text="Connecting to engine…" Foreground="#AEB6C2" FontSize="11" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Margin="12,12,12,0" Background="#20242A" CornerRadius="8" Padding="10">
      <StackPanel>
        <TextBlock Text="ACTIVE DOCUMENT" Foreground="#8F99A8" FontSize="10" />
        <TextBlock x:Name="ContextText" Text="Waiting for CorelDRAW context…" Foreground="#E8EBEF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="12,8,12,0" Background="#20242A" CornerRadius="8" Padding="10">
      <StackPanel>
        <TextBlock Text="OPENAI" Foreground="#8F99A8" FontSize="10" />
        <TextBlock Text="API key is encrypted for the current Windows user and is never displayed after saving."
                   Foreground="#AEB6C2" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,7" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" MinHeight="28"
                       Background="#252A31" Foreground="White" BorderBrush="#3A414B" Padding="7,4"
                       ToolTip="Paste an OpenAI API key. It will be encrypted with Windows DPAPI for this user." />
          <Button x:Name="SaveKeyButton" Grid.Column="1" Content="Save key" Margin="8,0,0,0" Padding="9,3"
                  Click="SaveKeyButton_Click" />
          <Button x:Name="ClearKeyButton" Grid.Column="2" Content="Clear" Margin="6,0,0,0" Padding="9,3"
                  Click="ClearKeyButton_Click" />
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="ModelBox" Grid.Column="0" MinHeight="28" SelectedIndex="0"
                    Background="#252A31" Foreground="White" BorderBrush="#3A414B" Padding="5,2">
            <ComboBoxItem Content="GPT-6.1 Sol — recommended" Tag="gpt-6.1-sol" />
            <ComboBoxItem Content="GPT-6 Astra — maximum capability" Tag="gpt-6-astra" />
            <ComboBoxItem Content="GPT-6 Luna — fast" Tag="gpt-6-luna" />
          </ComboBox>
          <Button x:Name="ApplyModelButton" Grid.Column="1" Content="Apply model" Margin="8,0,0,0" Padding="9,3"
                  Click="ApplyModelButton_Click" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Margin="12" Background="#111317" CornerRadius="8" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="ActivityText" Foreground="#D7DCE3" FontSize="12" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="4" Margin="12,0,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="PromptBox" Grid.Column="0" MinHeight="72" MaxHeight="150"
               AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               Background="#252A31" Foreground="White" BorderBrush="#3A414B" Padding="10"
               PreviewKeyDown="PromptBox_PreviewKeyDown"
               ToolTip="Describe what you want SolYan AI to do in the active CorelDRAW document." />
      <Button x:Name="SendButton" Grid.Column="1" Content="Run" Width="72" Margin="8,0,0,0"
              Click="SendButton_Click" IsDefault="False" />
    </Grid>

    <Grid Grid.Row="5" Margin="12,0,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <UniformGrid Grid.Row="0" Columns="3">
        <Button x:Name="RefreshButton" Content="Refresh" Margin="0,0,4,0" Click="RefreshButton_Click" />
        <Button x:Name="PreflightButton" Content="Preflight" Margin="0,0,4,0" Click="PreflightButton_Click"
                ToolTip="Check fonts, text overflow, bitmap resolution, RGB usage, locked objects and hidden/non-editable layers." />
        <Button x:Name="DiagnosticsButton" Content="Diagnostics" Click="DiagnosticsButton_Click"
                ToolTip="Run non-destructive Corel runtime, preview, preflight and engine health checks." />
      </UniformGrid>
      <UniformGrid Grid.Row="1" Columns="2" Margin="0,4,0,0">
        <Button x:Name="MutationTestButton" Content="Mutation Test" Margin="0,0,4,0" Click="MutationTestButton_Click"
                ToolTip="Explicit smoke test only. Briefly creates a 5 mm rectangle and immediately undoes it; may clear existing Redo history." />
        <Button x:Name="UndoButton" Content="Undo AI" Click="UndoButton_Click" />
      </UniformGrid>
      <TextBlock Grid.Row="2" Text="Ctrl+Enter to run" Foreground="#7F8998" FontSize="10" Margin="0,6,0,0" />
    </Grid>
  </Grid>
</UserControl>
